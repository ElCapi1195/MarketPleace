{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "VERTICAL",
        "NEXT_PUBLIC_BASE_PATH"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "generate": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "outputs": [
        "src/generated/**"
      ]
    }
  }
}
