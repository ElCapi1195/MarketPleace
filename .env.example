# Copiar a .env (ignorado por git). Valores de ejemplo, no reales.
NODE_ENV=development
VERTICAL=gamer
HOST=127.0.0.1
PORT=4311
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://marketplace_app:cambiar@127.0.0.1:5433/marketplace
REDIS_URL=redis://:cambiar@localhost:6380
PUBLIC_URL=http://localhost:4310
# Firma las sesiones. Al menos 32 caracteres aleatorios.
AUTH_SECRET=genera-uno-propio-y-no-uses-este-de-ejemplo
# Sin SMTP_URL, los correos se muestran en la consola de la API (solo desarrollo).
# Productos ficticios para ver la interfaz. Nunca en producción.
SHOW_SAMPLES=true
# Archivos subidos (fotos y modelos 3D). Relativo a apps/api.
MEDIA_DIR=../../storage/media
# Documentos de verificación de tiendas. Distinto de MEDIA_DIR.
DOCUMENTS_DIR=../../storage/documents
