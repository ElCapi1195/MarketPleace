generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Tablas de better-auth. Los nombres de modelo y campo los fija su adaptador.

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  platformRole     String      @default("customer")
  twoFactorEnabled Boolean     @default(false)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// Tablas propias.

/// Intento fallido de inicio de sesión. Guarda un HMAC del email, nunca el email.
model LoginFailure {
  id        BigInt   @id @default(autoincrement())
  emailHash String   @db.Char(64)
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([emailHash, at])
  @@map("login_failure")
}

/// Solo inserción: lo impone la base de datos (ver la migración), no la aplicación.
model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ipAddress  String?
  requestId  String?
  metadata   Json     @default("{}")

  @@index([at])
  @@index([actorId, at])
  @@index([targetType, targetId, at])
  @@map("audit_event")
}
