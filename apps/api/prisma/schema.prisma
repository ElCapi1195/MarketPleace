generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Tablas de better-auth. Los nombres de modelo y campo los fija su adaptador.

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  platformRole     String      @default("customer")
  twoFactorEnabled Boolean     @default(false)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  stores           StoreMember[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// Tablas propias.

/// Intento fallido de inicio de sesión. Guarda un HMAC del email, nunca el email.
model LoginFailure {
  id        BigInt   @id @default(autoincrement())
  emailHash String   @db.Char(64)
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([emailHash, at])
  @@map("login_failure")
}

/// Solo inserción: lo impone la base de datos (ver la migración), no la aplicación.
model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ipAddress  String?
  requestId  String?
  metadata   Json     @default("{}")

  @@index([at])
  @@index([actorId, at])
  @@index([targetType, targetId, at])
  @@map("audit_event")
}

/// Solo `name`, `slug` y `about` son públicos; lo demás sirve para verificarla.
model Store {
  id          String            @id @default(uuid(7)) @db.Uuid
  slug        String            @unique
  name        String
  about       String            @default("")
  legalName   String            @default("")
  taxId       String            @default("")
  phone       String            @default("")
  address     String            @default("")
  status      String            @default("DRAFT")
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  products    Product[]
  members     StoreMember[]
  documents   StoreDocument[]
  events      StoreEvent[]
  invitations StoreInvitation[]

  @@index([status, updatedAt])
  @@map("store")
}

model StoreMember {
  storeId   String   @db.Uuid
  userId    String
  role      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([storeId, userId])
  @@index([userId])
  @@map("store_member")
}

/// Documento de verificación. El id, aleatorio, es su clave en el almacén privado.
model StoreDocument {
  id         String   @id @db.Uuid
  storeId    String   @db.Uuid
  key        String
  type       String
  bytes      Int
  uploadedBy String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, key])
  @@map("store_document")
}

/// Historial de decisiones. Solo inserción: lo impone la base de datos.
model StoreEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  storeId    String   @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)
  action     String
  fromStatus String
  toStatus   String
  reason     String   @default("")
  actorId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, at])
  @@map("store_event")
}

/// Guarda el hash del token, nunca el token.
model StoreInvitation {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   String   @db.Uuid
  email     String
  role      String
  tokenHash String   @unique @db.Char(64)
  invitedBy String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, email])
  @@map("store_invitation")
}

model Product {
  id           String         @id @default(uuid(7)) @db.Uuid
  storeId      String         @db.Uuid
  slug         String         @unique
  title        String
  description  String
  categorySlug String
  kind         String
  priceMinor   Int
  depositMinor Int
  units        Int?
  availableOn  DateTime?      @db.Date
  attributes   Json           @default("{}")
  featured     Boolean        @default(false)
  status       String         @default("DRAFT")
  /// Texto plegado (sin tildes ni signos) para buscar.
  searchText   String
  /// Motivo del último rechazo en moderación.
  rejection    String         @default("")
  version      Int            @default(1)
  createdBy    String?
  publishedAt  DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  media        ProductMedia[]

  @@index([status, publishedAt])
  @@index([status, categorySlug])
  @@index([storeId])
  @@map("product")
}

/// Archivo de un producto. El id, aleatorio, es también su clave de almacenamiento.
model ProductMedia {
  id        String   @id @db.Uuid
  productId String   @db.Uuid
  kind      String
  alt       String   @default("")
  position  Int      @default(0)
  width     Int?
  height    Int?
  bytes     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, position])
  @@map("product_media")
}
