{
  "name": "@marketplace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node --enable-source-maps --env-file=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:db": "node --env-file=../../.env test/support/dev-db.ts",
    "seed:samples": "node --env-file=../../.env dist/scripts/seed-samples.js",
    "set-role": "node --env-file=../../.env dist/scripts/set-role.js"
  },
  "dependencies": {
    "@marketplace/contracts": "workspace:*",
    "@marketplace/core": "workspace:*",
    "@marketplace/verticals": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.27",
    "helmet": "8.3.0",
    "ioredis": "6.1.0",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "17.12.0-beta.19",
    "otpauth": "9.6.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
